                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/workouts">All Workouts</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/workouts?favourites=true">Favourites</a>
                        </li>
                        <li class="nav-item ms-lg-2">
                            <a class="btn btn-add" href="/add">+ Log Workout</a>
                        </li>
                    </ul>
                </div>
            </div>
